.page { min-height: 100vh; padding: 30rpx 24rpx 80rpx; }
.profile-card { padding: 44rpx 28rpx; display: flex; flex-direction: column; align-items: center; }
.avatar-button { width: 132rpx; height: 132rpx; padding: 0; margin: 0; border-radius: 36rpx; background: transparent; }
.avatar-button::after { border: none; }
.avatar { width: 132rpx; height: 132rpx; border-radius: 36rpx; }
.avatar-empty { display: flex; align-items: center; justify-content: center; color: #3157d5; font-size: 23rpx; background: #edf1ff; }
.avatar-tip { margin-top: 18rpx; color: #949bad; font-size: 23rpx; }
.form-card { margin-top: 22rpx; padding: 0 28rpx; }
.field-row { min-height: 104rpx; display: flex; align-items: center; border-bottom: 2rpx solid #f0f2f7; }
.field-row:last-child { border-bottom: none; }
.field-label { width: 180rpx; color: #626b7e; font-size: 27rpx; }
.field-input { flex: 1; text-align: right; font-size: 28rpx; }
.field-value { flex: 1; text-align: right; color: #3157d5; }
.tip-card { margin: 24rpx 10rpx 0; padding: 22rpx; color: #7a8396; font-size: 23rpx; line-height: 1.6; border-radius: 18rpx; background: #edf1ff; }
.save-btn { margin-top: 36rpx; }
