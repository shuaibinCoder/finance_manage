.page { min-height: 100vh; padding: 28rpx 24rpx 70rpx; }
.intro-card { padding: 30rpx; }
.intro-title, .intro-desc { display: block; }
.intro-title { font-size: 31rpx; font-weight: 700; }
.intro-desc { margin-top: 10rpx; color: #81899b; font-size: 23rpx; line-height: 1.6; }
.list-card { margin-top: 22rpx; padding: 0 28rpx; }
.notice-row { min-height: 134rpx; display: flex; align-items: center; border-bottom: 2rpx solid #f0f2f7; }
.notice-row:last-child { border-bottom: none; }
.notice-copy { flex: 1; display: flex; flex-direction: column; padding: 22rpx 20rpx 22rpx 0; }
.notice-label { font-size: 28rpx; font-weight: 600; }
.notice-desc { margin-top: 6rpx; color: #939bad; font-size: 21rpx; }
.notice-state { margin-top: 7rpx; color: #16875d; font-size: 20rpx; }
.notice-state.rejected { color: #d9485f; }
.notice-state.pending { color: #d18b17; }
.subscribe-button { padding: 13rpx 22rpx; color: #3157d5; border-radius: 16rpx; background: #edf1ff; font-size: 23rpx; }
.subscribe-button.done { color: #16875d; background: #e8f7f1; }
.guide-card { margin: 24rpx 10rpx 0; padding: 22rpx; color: #7c8497; font-size: 22rpx; line-height: 1.65; border-radius: 18rpx; background: #fff6dd; }

.notice-state.consumed { color: #d18b17; }
