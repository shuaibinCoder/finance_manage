<view class="page">
  <view class="intro-card card">
    <text class="intro-title">微信订阅提醒</text>
    <text class="intro-desc">订阅消息必须由你主动授权。三个场景使用同一“待办事项提醒”模板，但每个场景需要分别获得一次授权。</text>
  </view>

  <view class="switch-warning" wx:if="{{mainSwitchOff}}">
    微信订阅消息总开关已关闭，请先打开微信通知设置。
  </view>

  <view class="list-card card">
    <view class="notice-row" wx:for="{{items}}" wx:key="key">
      <view class="notice-copy">
        <text class="notice-label">{{item.label}}</text>
        <text class="notice-desc">{{item.desc}}</text>
        <text class="notice-state" wx:if="{{item.enabled}}">已获得一次授权</text>
        <text class="notice-state consumed" wx:elif="{{item.status === 'consumed'}}">本次授权已使用，请重新开启</text>
        <text class="notice-state rejected" wx:elif="{{item.platformBlocked}}">微信设置中已关闭，请前往设置</text>
        <text class="notice-state rejected" wx:elif="{{item.rejected}}">未授权，可重新开启</text>
        <text class="notice-state pending" wx:elif="{{!item.configured}}">模板待配置</text>
      </view>
      <view class="subscribe-button {{item.enabled ? 'done' : ''}}" data-key="{{item.key}}" bindtap="onSubscribe">
        {{requestingKey === item.key ? '请求中…' : (item.enabled ? '已开启' : '开启')}}
      </view>
    </view>
  </view>

  <view class="settings-button" bindtap="onOpenSettings">打开微信通知设置</view>

  <view class="guide-card">
    如果拒绝后不再弹出授权框，请点击“打开微信通知设置”，允许接收订阅消息后返回本页重新开启。
  </view>
</view>
