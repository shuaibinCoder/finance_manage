<view class="page">
  <view class="company-card">
    <view class="company-logo">{{companyInitial}}</view>
    <view class="company-info">
      <text class="company-name">{{company.name}}</text>
      <text class="company-meta">{{company.industry}} · 启用月份 {{company.startMonth}}</text>
    </view>
    <view class="edit-link" bindtap="onEditCompany">编辑</view>
  </view>

  <view class="stats-card card">
    <view class="stat-item">
      <text class="stat-value">{{reportCount}}</text>
      <text class="stat-label">月报总数</text>
    </view>
    <view class="stat-item">
      <text class="stat-value positive">{{confirmedCount}}</text>
      <text class="stat-label">已确认</text>
    </view>
    <view class="stat-item">
      <text class="stat-value primary">{{draftCount}}</text>
      <text class="stat-label">填写中</text>
    </view>
  </view>

  <view class="section-title">产品体验</view>
  <view class="menu-card card">
    <view class="menu-row" bindtap="onLoadDemo">
      <view class="menu-icon demo-icon">示</view>
      <view class="menu-copy">
        <text class="menu-title">加载演示数据</text>
        <text class="menu-desc">生成近六个月平衡的财务数据</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="onExport">
      <view class="menu-icon backup-icon">备</view>
      <view class="menu-copy">
        <text class="menu-title">复制数据备份</text>
        <text class="menu-desc">将本地JSON备份复制到剪贴板</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="section-title">数据管理</view>
  <view class="menu-card card">
    <view class="menu-row" bindtap="onClearReports">
      <view class="menu-icon clear-icon">清</view>
      <view class="menu-copy">
        <text class="menu-title">清空月报</text>
        <text class="menu-desc">保留企业资料，删除全部财务数据</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="onResetApp">
      <view class="menu-icon reset-icon">重</view>
      <view class="menu-copy">
        <text class="menu-title danger-text">重置应用</text>
        <text class="menu-desc">删除企业资料和全部月报</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="notice-card">
    <text class="notice-title">当前为本地MVP版本</text>
    <text class="notice-content">数据仅保存在当前微信设备中。正式商用前需要接入云端数据库、自动备份、多成员权限、Excel导入和服务端报表导出。</text>
  </view>

  <view class="version">小微财报 MVP 1.0</view>
</view>
