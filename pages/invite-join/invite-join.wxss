.page { min-height: 100vh; padding: 54rpx 28rpx 80rpx; }
.loading { padding-top: 180rpx; text-align: center; color: #8b93a7; }
.invite-card { display: flex; flex-direction: column; align-items: center; }
.company-icon { width: 112rpx; height: 112rpx; line-height: 112rpx; text-align: center; color: #fff; border-radius: 32rpx; background: linear-gradient(135deg,#3157d5,#7892ee); font-size: 48rpx; font-weight: 700; }
.invite-label { margin-top: 28rpx; color: #8b93a7; font-size: 24rpx; }
.company-name { margin-top: 8rpx; font-size: 38rpx; font-weight: 700; text-align: center; }
.company-industry { margin-top: 10rpx; color: #9299aa; font-size: 23rpx; }
.detail-card { margin-top: 36rpx; padding: 0 28rpx; }
.detail-row { min-height: 94rpx; display: flex; align-items: center; justify-content: space-between; color: #687184; border-bottom: 2rpx solid #f0f2f7; }
.detail-row:last-child { border-bottom: none; }
.detail-value { color: #172033; font-weight: 600; }
.permission-card { margin-top: 22rpx; padding: 28rpx; display: flex; flex-direction: column; color: #70798d; font-size: 24rpx; line-height: 1.7; }
.permission-title { margin-bottom: 8rpx; color: #172033; font-size: 28rpx; font-weight: 650; }
.join-btn { margin-top: 32rpx; }
.join-tip { display: block; margin-top: 18rpx; text-align: center; color: #a0a6b5; font-size: 22rpx; }
.error-card { padding: 60rpx 34rpx; display: flex; flex-direction: column; align-items: center; }
.error-icon { width: 82rpx; height: 82rpx; line-height: 82rpx; text-align: center; color: #fff; border-radius: 50%; background: #d9485f; font-size: 42rpx; }
.error-title { margin-top: 24rpx; font-size: 31rpx; font-weight: 700; }
.error-desc { margin-top: 12rpx; color: #8b93a7; text-align: center; line-height: 1.6; }
.home-btn { width: 300rpx; margin-top: 30rpx; }
