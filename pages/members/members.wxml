<view class="page">
  <view class="summary card">
    <view>
      <text class="summary-title">企业成员</text>
      <text class="summary-desc">共 {{members.length}} 人，角色权限由企业管理员维护</text>
    </view>
    <view class="invite-button" wx:if="{{isOwner}}" bindtap="onInvite">邀请成员</view>
  </view>

  <view class="member-list card">
    <view class="member-row" wx:for="{{members}}" wx:key="id" data-member="{{item}}" bindtap="onMemberAction">
      <image class="avatar" wx:if="{{item.avatarFileId}}" src="{{item.avatarFileId}}" mode="aspectFill"></image>
      <view class="avatar avatar-empty" wx:else>{{item.initial}}</view>
      <view class="member-copy">
        <view class="member-name-row">
          <text class="member-name">{{item.displayName}}</text>
          <text class="self-tag" wx:if="{{item.isSelf}}">我</text>
        </view>
        <text class="member-role">{{item.roleLabel}}</text>
      </view>
      <text class="member-arrow" wx:if="{{item.canManage}}">›</text>
    </view>
  </view>

  <view class="role-card card">
    <text class="role-title">角色说明</text>
    <text>企业管理员：企业设置、邀请和成员管理</text>
    <text>财务人员：填报并提交月报</text>
    <text>老板：查看、退回和确认月报</text>
    <text>查看者：只读查看财务报表</text>
  </view>
</view>
