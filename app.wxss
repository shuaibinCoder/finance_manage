page {
  min-height: 100%;
  background: #f4f6fa;
  color: #172033;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', sans-serif;
}

view,
text,
input,
button,
picker,
scroll-view {
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 26rpx rgba(32, 48, 88, 0.06);
}

.muted {
  color: #8b93a7;
}

.primary {
  color: #3157d5;
}

.positive {
  color: #16875d;
}

.negative {
  color: #d9485f;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  color: #8b93a7;
  background: #eef1f7;
}

.status-pill.confirmed {
  color: #16875d;
  background: #e8f7f1;
}

.btn-primary,
.btn-secondary,
.btn-danger {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary {
  color: #ffffff;
  background: #3157d5;
  box-shadow: 0 10rpx 24rpx rgba(49, 87, 213, 0.25);
}

.btn-secondary {
  color: #3157d5;
  background: #edf1ff;
}

.btn-danger {
  color: #d9485f;
  background: #fff0f2;
}
